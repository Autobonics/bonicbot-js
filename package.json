{
    "name": "bonicbot",
    "version": "2.0.4",
    "description": "JavaScript library for controlling BonicBot humanoid robot via serial and WebSocket communication with sequence and camera support",
    "main": "dist/index.js",
    "module": "src/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "test": "jest",
        "lint": "eslint src/**/*.js",
        "prepare": "npm run build"
    },
    "keywords": [
        "robot",
        "robotics",
        "bonicbot",
        "humanoid",
        "servo",
        "websocket",
        "serial",
        "browser",
        "automation"
    ],
    "author": "Shahir Abdulla <shahir@autobonics.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/autobonics/bonicbot-js.git"
    },
    "bugs": {
        "url": "https://github.com/autobonics/bonicbot-js/issues"
    },
    "homepage": "https://github.com/autobonics/bonicbot-js#readme",
    "files": [
        "dist/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "browser": {
        "serial": false
    },
    "devDependencies": {
        "@babel/preset-env": "^7.28.3",
        "@rollup/plugin-commonjs": "^24.1.0",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-terser": "^0.4.4",
        "babel-jest": "^30.1.2",
        "eslint": "^8.57.1",
        "jest": "^29.7.0",
        "rollup": "^3.29.5"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "browserslist": [
        "last 2 versions",
        "> 1%",
        "not dead"
    ],
    "dependencies": {
        "bonicbot": "^2.0.3"
    }
}